# Copy this file to `.env` and fill in your own key:
#
#   cp .env.example .env
#
# Get a key at https://platform.openai.com/api-keys, then restart the dev
# server with `npx expo start --clear`. Expo only reads .env files at startup,
# so a running server will not pick up changes made here.
#
# Anything prefixed with EXPO_PUBLIC_ is inlined into the JavaScript bundle and
# is readable by anyone who installs the app. That is acceptable for a personal
# development key with a low spending limit, but for a released app the calls
# should be proxied through your own backend so the key stays on the server.
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here
